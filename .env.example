# 前端只知道 API 地址，不能在 VITE_ 变量中保存 TEST_API_KEY 或数据库连接串。
# 本地临时开放演示页面：在 .env.local 中设为 true；生产构建不会启用。
VITE_TEMP_PREVIEW_ACCESS=false
# 可选的本地模拟账号，只在上述开发开关启用时生效；请勿填写真实账号密码。
VITE_SIM_PLAYER_USERNAME=
VITE_SIM_PLAYER_PASSWORD=
VITE_SIM_STAFF_USERNAME=
VITE_SIM_STAFF_PASSWORD=
VITE_ENABLE_TEST_LAB=false
VITE_TEST_API_BASE_URL=https://hrgos.skyseiun.com
VITE_ENABLE_LIVE_GAME=false
VITE_GAME_API_BASE_URL=https://hrgos.skyseiun.com
VITE_GAME_ID=
# 下面供命令行后端测试使用；复制到 .env.test.local 后配置，不提交 Git。
HRG_TEST_API_URL=https://hrgos.skyseiun.com
TEST_API_KEY=
GAME_ADMIN_KEY=
