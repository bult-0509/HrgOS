{
  "name": "hrg-game-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:backend": "node --test server/rules.check.mjs server/persistence.check.mjs server/abilities.check.mjs server/live.check.mjs server/periodicCards.check.mjs server/bingoBoards.check.mjs server/scoring.check.mjs server/photoFinds.check.mjs",
    "sync:scoring": "node scripts/sync-scoring-plan.mjs",
    "test:abilities": "node --env-file-if-exists=.env.test.local scripts/test-rules.mjs --abilities",
    "test:abilities:local": "node scripts/test-rules.mjs --local --abilities",
    "test:rules": "node --env-file-if-exists=.env.test.local scripts/test-rules.mjs",
    "test:rules:local": "node scripts/test-rules.mjs --local",
    "test:readiness": "node --env-file-if-exists=.env.test.local scripts/test-rules.mjs --readiness",
    "test:readiness:local": "node scripts/test-rules.mjs --local --readiness",
    "test:lab": "node scripts/start-test-lab.mjs",
    "server": "node --env-file-if-exists=.env.test.local server/start.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.3",
    "@fontpkg/alimama-fang-yuan-ti-vf": "^1.0.5",
    "@noble/hashes": "1.8.0",
    "fastify": "^5.12.5",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
